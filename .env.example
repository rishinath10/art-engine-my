# Supabase project the shop talks to. Both are build-time values: Vite bakes
# them into the bundle, so set them in Coolify as build variables, not runtime.
# The anon key is public by design — row level security is what protects data.
# Stripe secrets never live here; they belong in Supabase secrets only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
